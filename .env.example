# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan commit .env.local.

# Situs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=
# Proyek Supabase baru: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# Proyek lama: NEXT_PUBLIC_SUPABASE_ANON_KEY. Isi salah satu.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hanya untuk server (admin/service role). Jangan pakai di client.
SUPABASE_SERVICE_ROLE_KEY=

# Database Prisma
# Runtime: pooled connection Supabase (port 6543, pgbouncer=true)
DATABASE_URL=
# Migrasi: direct/session connection (Supabase port 5432)
DIRECT_URL=

# Peta & routing
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Endpoint OSRM yang mendukung profil pejalan kaki.
# Demo publik hanya untuk pengembangan; produksi wajib self-host.
NEXT_PUBLIC_OSRM_URL=https://routing.openstreetmap.de/routed-foot

# Moderasi AI (Gemini) untuk postingan Jelajahi.
# Default mati: postingan langsung PUBLISHED. Set true untuk mengaktifkan.
AI_MODERATION_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODERATION_MODEL=gemini-3.1-flash-lite

# Seed (opsional). Seed hanya membuat profil untuk auth.users yang sudah ada.
SEED_ORGANIZER_EMAIL=
# Hanya untuk development. Set true bila seed boleh menaikkan role USER menjadi
# ORGANIZER untuk akun pengujian. Di production nilai ini selalu diabaikan.
SEED_ALLOW_ROLE_PROMOTION=false

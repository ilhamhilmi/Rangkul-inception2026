# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (dipakai pada fase auth; belum diperlukan Fitur 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database (Prisma)
# Runtime: pooled connection Supabase (port 6543)
DATABASE_URL=
# Migrasi: direct/session connection (port 5432)
DIRECT_URL=

# Peta & routing
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Endpoint OSRM yang mendukung profil pejalan kaki.
# Demo publik hanya untuk pengembangan; produksi wajib self-host.
NEXT_PUBLIC_OSRM_URL=https://routing.openstreetmap.de/routed-foot

# Moderasi AI (Gemini) untuk postingan Jelajahi.
# Default mati: postingan langsung PUBLISHED. Set true untuk mengaktifkan.
AI_MODERATION_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODERATION_MODEL=gemini-3.1-flash-lite

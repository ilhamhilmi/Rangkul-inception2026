// Fondasi database Volunteer Rangkul.
// Sumber kebenaran: docs/database.md dan schema database bersama yang sudah
// diterapkan tim (profiles, communities, verification_requests).
//
// Catatan rekonsiliasi:
// - profiles, communities, dan verification_requests TIDAK dibuat ulang oleh
//   migration Volunteer. Model di bawah hanya memetakan struktur aktual.
// - Enum bersama memakai nama PascalCase di PostgreSQL, sehingga tidak diberi
//   @@map. Enum baru Volunteer juga PascalCase dan dibuat additive.
// - community_id sengaja belum memiliki relasi/FK ke communities sampai
//   relasi dengan fitur Komunitas disepakati.
// - Constraint yang tidak dapat diekspresikan Prisma (partial unique index,
//   functional unique index, check constraint, trigger agregat, RLS) ditulis
//   di migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enum bersama: sudah ada di database sebagai "UserRole", "VerificationType",
// dan "VerificationStatus". Jangan membuat ulang atau memberi @@map.
enum UserRole {
  USER
  ORGANIZER
  ADMIN
}

// Enum baru khusus Volunteer, additive.
enum EventStatus {
  DRAFT
  PENDING
  PUBLISHED
  CLOSED
  REJECTED
}

enum EventCategory {
  EVENT_SUPPORT
  ACCESSIBILITY_AUDIT
  SOCIAL_ACTIVITY
  INCLUSIVE_PROGRAM
  OTHER
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum VerificationType {
  COMMUNITY
  ORGANIZER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Struktur aktual tabel bersama. updated_at tidak memiliki default di database;
// Prisma mengisinya lewat @updatedAt saat create/update.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique(map: "profiles_email_key")
  name      String
  role      UserRole @default(USER)
  avatarUrl String?  @map("avatar_url")
  bio       String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizedEvents        VolunteerEvent[]       @relation("EventOrganizer")
  eventRegistrations     EventRegistration[]
  verificationRequests   VerificationRequest[]  @relation("VerificationRequester")
  reviewedVerifications  VerificationRequest[]  @relation("VerificationReviewer")

  @@index([role], map: "idx_profiles_role")
  @@map("profiles")
}

model VolunteerEvent {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String         @unique(map: "uq_volunteer_events_slug")
  organizerId        String         @map("organizer_id") @db.Uuid
  // FK ke communities ditunda sampai struktur tabel komunitas disepakati.
  communityId        String?        @map("community_id") @db.Uuid
  title              String
  description        String         @db.Text
  category           EventCategory
  locationName       String         @map("location_name")
  address            String
  city               String
  province           String
  latitude           Decimal?       @db.Decimal(9, 6)
  longitude          Decimal?       @db.Decimal(9, 6)
  startsAt           DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime       @map("ends_at") @db.Timestamptz(6)
  requirements       String?        @db.Text
  accessibilityNotes String?        @map("accessibility_notes") @db.Text
  slots              Int
  registeredCount    Int            @default(0) @map("registered_count")
  status             EventStatus    @default(DRAFT)
  coverUrl           String?        @map("cover_url")
  coverAlt           String?        @map("cover_alt")
  publishedAt        DateTime?      @map("published_at") @db.Timestamptz(6)
  archivedAt         DateTime?      @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizer     Profile             @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict, map: "fk_volunteer_events_organizer_id")
  registrations EventRegistration[]

  @@index([status, startsAt], map: "idx_volunteer_events_status_start")
  @@index([organizerId], map: "idx_volunteer_events_organizer")
  @@index([communityId], map: "idx_volunteer_events_community")
  @@index([province, city], map: "idx_volunteer_events_location")
  @@map("volunteer_events")
}

model EventRegistration {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String             @map("event_id") @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  name               String             @db.VarChar(80)
  email              String
  phone              String
  accessibilityNeeds String?            @map("accessibility_needs") @db.VarChar(500)
  status             RegistrationStatus @default(PENDING)
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event VolunteerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "fk_event_registrations_event_id")
  user  Profile        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_event_registrations_user_id")

  @@unique([eventId, userId], map: "uq_event_registrations_event_user")
  @@index([eventId, status], map: "idx_event_registrations_event_status")
  @@index([userId], map: "idx_event_registrations_user")
  @@map("event_registrations")
}

model VerificationRequest {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  type        VerificationType
  payload     Json               @default("{}")
  documentUrl String?            @map("document_url")
  status      VerificationStatus @default(PENDING)
  reviewerId  String?            @map("reviewer_id") @db.Uuid
  reviewNote  String?            @map("review_note")
  submittedAt DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt  DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user     Profile  @relation("VerificationRequester", fields: [userId], references: [id], onDelete: Cascade, map: "verification_requests_user_id_fkey")
  reviewer Profile? @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull, map: "verification_requests_reviewer_id_fkey")

  @@index([status, submittedAt], map: "idx_verification_requests_status")
  @@map("verification_requests")
}
